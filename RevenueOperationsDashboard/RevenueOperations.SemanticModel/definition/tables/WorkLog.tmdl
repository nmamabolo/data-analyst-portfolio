		lineageTag: 9d90415b-4a6b-4b4d-801b-dc1f3d7bbc0a
		summarizeBy: none
		sourceColumn: Date Key

	column 'Month Key'
		dataType: int64
		lineageTag: c44b7f5b-9a39-42df-9cd9-c0ad5d0976db
		summarizeBy: count
		sourceColumn: Month Key

		annotation SummarizationSetBy = Automatic

	column 'Employee Key'
		dataType: int64
		lineageTag: abfa8f3b-1ec6-4964-bb5b-f30282479882
		summarizeBy: none
		sourceColumn: Employee Key

	column 'Client Key'
		dataType: int64
		lineageTag: 7af85822-a8f7-4f38-ab94-b95acf4c8c44
		summarizeBy: none
		sourceColumn: Client Key

	column 'Available Hours'
		dataType: double
		lineageTag: a848c290-c321-459d-ac3a-c4faf9bb59cb
		summarizeBy: sum
		sourceColumn: Available Hours

		annotation SummarizationSetBy = Automatic

	column 'Billable Hours'
		dataType: double
		lineageTag: b848f1ea-b85f-4b16-b544-dc8eccc9145d
		summarizeBy: sum
		sourceColumn: Billable Hours

		annotation SummarizationSetBy = Automatic

	column 'Non-Billable Hours'
		dataType: double
		lineageTag: 6742fe13-2e56-4a0c-b0f8-4ffc5042e3c3
		summarizeBy: sum
		sourceColumn: Non-Billable Hours

		annotation SummarizationSetBy = Automatic

	column Revenue
		dataType: double
		lineageTag: 47e2c811-f79e-4a94-b634-fe31a575e2c7
		summarizeBy: sum
		sourceColumn: Revenue

		annotation SummarizationSetBy = Automatic

	column 'Labor Cost'
		dataType: double
		lineageTag: 835e78ad-3617-4cb8-86a7-3172c9edb531
		summarizeBy: sum
		sourceColumn: Labor Cost

		annotation SummarizationSetBy = Automatic

	column 'Work Status'
		dataType: string
		lineageTag: 7de93f98-31fe-4f2e-badc-742d5715178e
		summarizeBy: none
		sourceColumn: Work Status

	partition WorkLog = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents(SourceWorkbookPath), null, true),
					#"Selected WorkLog sheet" = Source{[Item="WorkLog",Kind="Sheet"]}[Data],
					#"Promoted column headers" = Table.PromoteHeaders(#"Selected WorkLog sheet", [PromoteAllScalars=true]),
					#"Applied column types" = Table.TransformColumnTypes(#"Promoted column headers", {{"Log ID", Int64.Type}, {"Date", type date}, {"Date Key", Int64.Type}, {"Month Key", Int64.Type}, {"Employee Key", Int64.Type}, {"Client Key", Int64.Type}, {"Available Hours", type number}, {"Billable Hours", type number}, {"Non-Billable Hours", type number}, {"Revenue", type number}, {"Labor Cost", type number}, {"Work Status", type text}})
				in
					#"Applied column types"

